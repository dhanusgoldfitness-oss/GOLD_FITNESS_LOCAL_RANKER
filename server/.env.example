# Claude for text (AI Mode, review replies, audits, captions). Images/video still need GEMINI_API_KEY.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
AI_TEXT_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
AI_IMAGE_PROVIDER=auto
OPENAI_BASE_URL=https://api.openai.com/v1
# NVIDIA example: OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1  OPENAI_MODEL=openai/gpt-oss-20b  OPENAI_API_KEY=<nvapi key>
