# Google Maps Platform key with Places API (New) enabled — used for rank checks and competitors
GOOGLE_MAPS_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
